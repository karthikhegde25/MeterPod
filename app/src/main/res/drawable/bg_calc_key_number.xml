<?xml version="1.0" encoding="utf-8"?>
<!-- Calculator digit key. Appearance only: raised 3D key (side wall + glossy face),
     face sinks when pressed, flattens when disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="1.2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="1.2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#14181C" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="0dp" android:bottom="2.4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2C3238" android:endColor="#3A4048" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#2A3036" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="2dp" android:bottom="2.4dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="6.4dp" android:bottomRightRadius="6.4dp" />
                </shape>
            </item>
        </layer-list>
            </item>
            <item android:state_pressed="true">
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="2.4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="2.4dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="2.4dp" android:bottom="1.6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#222A32" android:endColor="#3E4853" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#566270" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="4.4dp" android:bottom="1.6dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="6.4dp" android:bottomRightRadius="6.4dp" />
                </shape>
            </item>
        </layer-list>
            </item>
            <item>
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="0dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#222A32" android:endColor="#3E4853" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#566270" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="2dp" android:bottom="4dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="6.4dp" android:bottomRightRadius="6.4dp" />
                </shape>
            </item>
        </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
