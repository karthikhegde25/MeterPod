<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action button (Generate, Save, Share, Lock...). Appearance only: raised 3D key (side wall + glossy face),
     face sinks when pressed, flattens when disabled. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="1.5dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#14181C" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="0dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2C3238" android:endColor="#3A4048" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#2A3036" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="2dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="9.6dp" android:bottomRightRadius="9.6dp" />
                </shape>
            </item>
        </layer-list>
            </item>
            <item android:state_pressed="true">
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="3dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B3F94" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="3dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3A78EB" android:endColor="#7CAEFF" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#A9C8FF" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="5dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="9.6dp" android:bottomRightRadius="9.6dp" />
                </shape>
            </item>
        </layer-list>
            </item>
            <item>
        <layer-list>
            <!-- soft ground shadow -->
            <item android:top="2.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- side wall -->
            <item android:top="2.5dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B3F94" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <!-- face -->
            <item android:top="0dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#3A78EB" android:endColor="#7CAEFF" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#A9C8FF" />
                </shape>
            </item>
            <!-- gloss highlight on upper half -->
            <item android:top="2dp" android:bottom="5dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#2EFFFFFF" />
                    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" android:bottomLeftRadius="9.6dp" android:bottomRightRadius="9.6dp" />
                </shape>
            </item>
        </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
