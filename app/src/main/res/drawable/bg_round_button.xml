<?xml version="1.0" encoding="utf-8"?>
<!-- Round +/- stepper key (blue). Appearance only. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <selector>
            <item android:state_pressed="true">
        <layer-list>
            <item android:top="2.4dp"><shape android:shape="oval"><solid android:color="#66000000" /></shape></item>
            <item android:top="2.4dp"><shape android:shape="oval"><solid android:color="#1B3F94" /></shape></item>
            <item android:top="2.4dp" android:bottom="1.6dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#3A78EB" android:endColor="#7CAEFF" />
                    <stroke android:width="1dp" android:color="#A9C8FF" />
                </shape>
            </item>
            <item android:top="4.4dp" android:bottom="1.6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#33FFFFFF" />
                </shape>
            </item>
        </layer-list>
            </item>
            <item>
        <layer-list>
            <item android:top="2dp"><shape android:shape="oval"><solid android:color="#66000000" /></shape></item>
            <item android:top="2dp"><shape android:shape="oval"><solid android:color="#1B3F94" /></shape></item>
            <item android:top="0dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#3A78EB" android:endColor="#7CAEFF" />
                    <stroke android:width="1dp" android:color="#A9C8FF" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="4dp" android:left="6dp" android:right="6dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#33FFFFFF" />
                </shape>
            </item>
        </layer-list>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask" android:bottom="4dp"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></item>
</ripple>
