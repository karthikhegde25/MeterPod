<?xml version="1.0" encoding="utf-8"?>
<!-- Home tile as a raised 3D card; sinks when pressed. Appearance only. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#66000000" /><corners android:radius="18dp" /></shape></item>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#0A0E12" /><corners android:radius="18dp" /></shape></item>
            <item android:top="3dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#222B35" android:endColor="#323E4B" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="#46525F" />
                </shape>
            </item>
            <item android:top="5dp" android:bottom="2dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#16FFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#66000000" /><corners android:radius="18dp" /></shape></item>
            <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#0A0E12" /><corners android:radius="18dp" /></shape></item>
            <item android:top="0dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#222B35" android:endColor="#323E4B" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="#46525F" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="5dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#16FFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" android:bottomLeftRadius="6dp" android:bottomRightRadius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
