<?xml version="1.0" encoding="utf-8"?>
<!-- Recessed circular well behind each tile icon. Appearance only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#1B2A4D" android:endColor="#0F1830" />
            <stroke android:width="1.5dp" android:color="#0A0E12" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#2E4577" android:endColor="#22335A" />
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#334A7A" />
        </shape>
    </item>
</layer-list>
