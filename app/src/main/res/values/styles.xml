<resources>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!--
        Shared base for every calculator key. Plain <Button> (and
        style="?android:attr/buttonStyleSmall") pull in Material's default
        MaterialButton styling - built-in insets, a minimum width/height,
        elevation/shadow, and an all-caps transform - and those defaults
        differ between the default style and buttonStyleSmall. Mixing the
        two in the same grid (as the old layout did: digits with no style,
        operators with buttonStyleSmall) is exactly what made the keys look
        like mismatched, not-quite-aligned boxes instead of a uniform grid.
        This style zeroes all of that out so every key - no matter its
        row - is sized purely by its layout_weight, with one consistent
        shape supplied by its own background drawable.
    -->
    <style name="CalcKey" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <!-- keeps the label centred on the raised face (3D wall is 4dp) -->
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!--
        Shared base for every ordinary action button in the app (Reset,
        Calibrate, Save, Share, Lock, Refresh, ...). Same reasoning as
        CalcKey: a plain <Button> pulls in Material's default insets,
        minimum size, drop shadow and all-caps text, which is what made
        buttons across different screens look inconsistent with each
        other - some flat pills, some shadowed Material buttons, none of
        them matching the deliberately "real, simulated key" look used
        for the calculator and the round +/- steppers. Every button in
        the app now goes through this one style plus one of the
        bg_app_button_* drawables, so they all read as the same family
        of physical-looking buttons.
    -->
    <style name="RealButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">13dp</item>
    </style>

    <!-- A small, square-ish variant for compact icon-style buttons (Lock). -->
    <style name="RealButton.Compact">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
