<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <TextView
        android:id="@+id/stepsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textColor="@color/textPrimary"
        android:textSize="52sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/stepsSubLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="steps today"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/stepsText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/distanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0.00 km"
        android:textColor="@color/accent"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/stepsSubLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/footLengthRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/distanceText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Foot length:"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/footLengthMinusButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/footLengthText"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="26.0 cm"
            android:textColor="@color/textPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/footLengthPlusButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="18sp" />

    </LinearLayout>

    <com.karthikhegde.meterpod.ui.StepHistoryChartView
        android:id="@+id/historyChart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/footLengthRow"
        app:layout_constraintBottom_toTopOf="@id/instructions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Tracks steps only while MeterPod is open (no background service). Distance is estimated from your foot length using a common rule-of-thumb (step length ≈ 4x foot length), not a precise measurement — adjust the foot length above to personalize it."
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
