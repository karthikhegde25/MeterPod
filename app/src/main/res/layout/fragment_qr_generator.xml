<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/surface">

            <ImageView
                android:id="@+id/qrPreviewImage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

            <ProgressBar
                android:id="@+id/qrProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Content type -->
        <TextView
            style="@style/SectionLabel"
            android:text="Content Type" />
        <Spinner
            android:id="@+id/contentTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:id="@+id/dynamicFieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!-- Style -->
        <TextView
            style="@style/SectionLabel"
            android:text="Style" />

        <!-- Foreground (QR dots) colour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="QR Colour (foreground)" />
            <View
                android:id="@+id/foregroundSwatch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_color_swatch" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/foregroundPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp" />
        <com.karthikhegde.meterpod.ui.HsvPickerView
            android:id="@+id/foregroundColorPicker"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <!-- Background colour -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                style="@style/FieldLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Background Colour" />
            <View
                android:id="@+id/backgroundSwatch"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_color_swatch" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/backgroundPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="6dp" />
        <com.karthikhegde.meterpod.ui.HsvPickerView
            android:id="@+id/backgroundColorPicker"
            android:layout_width="match_parent"
            android:layout_height="140dp" />

        <TextView
            android:id="@+id/dotShapeLabel"
            style="@style/FieldLabel"
            android:text="Dot Shape" />
        <Spinner
            android:id="@+id/dotShapeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/eyeShapeLabel"
            style="@style/FieldLabel"
            android:text="Eye Shape" />
        <Spinner
            android:id="@+id/eyeShapeSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:id="@+id/errorCorrectionLabel"
            style="@style/FieldLabel"
            android:text="Error Correction" />
        <Spinner
            android:id="@+id/errorCorrectionSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Logo (optional)"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pickLogoButton"
                style="@style/RealButton.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:text="Choose"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/removeLogoButton"
                style="@style/RealButton.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_app_button_secondary"
                android:text="Remove"
                android:textColor="@color/textPrimary"
                android:visibility="gone" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/logoSizeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="20"
            android:visibility="gone" />

        <!-- Actions -->
        <Button
            android:id="@+id/generateButton"
            style="@style/RealButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_button"
            android:text="Generate"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:weightSum="2">

            <Button
                android:id="@+id/saveButton"
                style="@style/RealButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:enabled="false" />

            <Button
                android:id="@+id/shareButton"
                style="@style/RealButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_button"
                android:text="Share"
                android:textColor="#FFFFFF"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
