<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_about_card"
            android:paddingTop="24dp"
            android:paddingBottom="22dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="MeterPod logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MeterPod"
                android:textColor="@color/textPrimary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Version 1.0"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="A pocket toolbox of measuring tools, sensors, converters and utilities - all in one small, offline app."
                android:textColor="@color/textSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/toolCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="20 tools"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Developer -->
        <TextView style="@style/SectionLabel" android:text="Developer" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_about_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karthik Hegde"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MeterPod is open source."
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- License -->
        <TextView style="@style/SectionLabel" android:text="License" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_about_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GNU General Public License v3.0"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="You are free to use, study, share and modify this app under the terms of the GPL 3."
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
            <Button
                android:id="@+id/licenseButton"
                style="@style/RealButton.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_button_secondary"
                android:textColor="@color/textPrimary"
                android:text="Read the license" />
        </LinearLayout>

        <!-- Source code -->
        <TextView style="@style/SectionLabel" android:text="Source code" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_about_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="github.com/karthikhegde25/MeterPod"
                android:textColor="@color/accent"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/repoButton"
                    style="@style/RealButton.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_app_button_primary"
                    android:textColor="@color/textPrimary"
                    android:text="Open repository" />
                <Button
                    android:id="@+id/issuesButton"
                    style="@style/RealButton.Compact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_button_secondary"
                    android:textColor="@color/textPrimary"
                    android:text="Report an issue" />
            </LinearLayout>
        </LinearLayout>

        <!-- Credits -->
        <TextView style="@style/SectionLabel" android:text="Credits" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_about_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Generator"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Content types and code formats are adapted from Image Toolbox's QR code feature. Thanks to the Image Toolbox project and its contributors. Encoding by ZXing."
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
            <Button
                android:id="@+id/imageToolboxButton"
                style="@style/RealButton.Compact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_secondary"
                android:textColor="@color/textPrimary"
                android:text="Image Toolbox" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="Works fully offline. No ads, no tracking."
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
