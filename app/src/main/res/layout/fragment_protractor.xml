<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.karthikhegde.meterpod.ui.ProtractorView
            android:id="@+id/protractorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/lockButton"
            style="@style/RealButton.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_app_button_primary"
            android:textColor="@color/textPrimary"
            android:rotation="90"
            android:text="Lock" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/minusButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_round_button"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:rotation="90" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/plusButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_round_button"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/angleReadoutText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Angle: 90.00°"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
